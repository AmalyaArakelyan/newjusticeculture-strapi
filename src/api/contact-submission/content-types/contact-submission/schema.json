{
  "kind": "collectionType",
  "collectionName": "contact_submissions",
  "info": {
    "singularName": "contact-submission",
    "pluralName": "contact-submissions",
    "displayName": "Contact us"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "submittedAt": {
      "type": "datetime",
      "pluginOptions": {
        "content-manager": {
          "editable": false
        }
      }
    },
    "fullName": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "phone": {
      "type": "string",
      "required": true
    },
    "message": {
      "type": "text"
    }
  }
}
